Screen {
    background: $surface;
}

#logo {
    height: auto;
    padding: 1 2 0 2;
    text-style: bold;
}

#toolbar {
    height: auto;
    padding: 1 2 0 2;
    background: $panel;
}

#toolbar Button {
    margin: 0 2 0 0;
    min-width: 16;
}

#banner {
    padding: 1 2 0 2;
    height: auto;
    color: $text-muted;
}

#view-title {
    padding: 1 2 0 2;
    height: auto;
    color: $foreground;
    text-style: bold;
}

#body {
    padding: 1 2;
    height: 1fr;
}

#bottom {
    dock: bottom;
    height: auto;
    background: $panel;
    border-top: solid $accent 30%;
}

.section {
    margin: 1 0 0 0;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

DataTable {
    height: auto;
    max-height: 20;
    margin: 0 0 1 0;
    background: $panel;
}

.callout {
    margin: 1 0;
    padding: 1 2;
    background: $panel;
    border-left: thick $warning;
}

.callout.ok {
    border-left: thick $success;
}

#score {
    padding: 1 2;
    margin: 0 0 1 0;
    background: $panel;
    border-left: thick $accent;
    text-style: bold;
}

#status {
    height: auto;
    padding: 0 2;
    background: $panel;
    color: $text-muted;
}

/* Confirmation dialog */

Confirm {
    align: center middle;
}

#dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $accent;
}

#dialog-title {
    text-style: bold;
    color: $accent;
    margin: 0 0 1 0;
}

#dialog-body {
    height: auto;
    margin: 0 0 1 0;
}

#dialog-buttons {
    height: auto;
    align: right middle;
}

#dialog-buttons Button {
    margin: 0 0 0 2;
}

#restore-list {
    height: auto;
    max-height: 12;
    margin: 0 0 1 0;
    background: $panel;
}
